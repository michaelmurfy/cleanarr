{
  "name": "Cleanarr",
  "short_name": "Cleanarr",
  "description": "Reclaim disk space from Radarr and Sonarr using watch history and request data.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0c1018",
  "theme_color": "#0c1018",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
