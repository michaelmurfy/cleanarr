CLEANARR_USERNAME=admin
CLEANARR_PASSWORD=changeme
CLEANARR_SECRET=change-this-to-a-long-random-string

# Set to 1 to hide service URLs, API keys, and login from Settings (manage them here instead).
# Leave at 0 (or omit) so you can configure services in the UI.
CLEANARR_HIDE_SETTINGS=0

# User the container runs as, and who owns everything in /data.
PUID=1000
PGID=1000

TAUTULLI_URL=
TAUTULLI_API_KEY=
TRACEARR_URL=
TRACEARR_API_KEY=
JELLYSTAT_URL=
JELLYSTAT_API_KEY=
SEERR_URL=
SEERR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
SEERR_EXTERNAL_URL=
RADARR_EXTERNAL_URL=
SONARR_EXTERNAL_URL=
TAUTULLI_EXTERNAL_URL=
TRACEARR_EXTERNAL_URL=
JELLYSTAT_EXTERNAL_URL=
